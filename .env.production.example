# Template for .env.production (publishing Stage 3f).
# Copy to .env.production ON THE MACHINE THAT RUNS THE STACK and fill it in.
# .env.production is gitignored. Real values exist only on the server.
# Use long alphanumeric passwords (e.g. `openssl rand -hex 32`): special
# characters would need URL-encoding inside DATABASE_URL.

SITE_ADDRESS=localhost
# Bootstrap database only (C-5.8). Published data lives in
# name_generator_<stamp> databases created by restore_reference.sh; naming
# this name_generator would create an empty database with master's name.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
# The backend connects as the least-privilege nameforge_app role (Stage 2d,
# backend/scripts/publish/roles.sql + grants.sql) to the CURRENT published
# database. Each publish restores into a new database
# (name_generator_<stamp>, restore_reference.sh); switching to it means
# changing PUBLISH_DB and the database name at the end of DATABASE_URL, then
# restarting the backend. Keep the previous database for one publish cycle
# as the rollback.
PUBLISH_DB=name_generator_YYYYMMDD
DATABASE_URL=postgresql+psycopg://nameforge_app:change-me-app@db:5432/name_generator_YYYYMMDD
# Role passwords. Used once per Postgres cluster by roles.sql (passed into the
# container with `docker exec -e NAMEFORGE_ADMIN_PASSWORD -e
# NAMEFORGE_APP_PASSWORD`); the app password must match DATABASE_URL.
NAMEFORGE_ADMIN_PASSWORD=change-me-admin
NAMEFORGE_APP_PASSWORD=change-me-app
SENTRY_DSN=
IMAGE_TAG=latest

# DB_MEMORY_LIMIT=8g from C-5.12: the HNSW index is 5.87 GiB, and the
# database sat at its 6 GiB cap during the restore's HNSW build. E2 sizes the
# remaining values for the server (B-2.5); effective_cache_size also steers
# the planner, which decides how a vector query runs.
PG_SHARED_BUFFERS=512MB
PG_EFFECTIVE_CACHE_SIZE=4GB
PG_MAINTENANCE_WORK_MEM=512MB
DB_MEMORY_LIMIT=8g
BACKEND_MEMORY_LIMIT=3g
